<Window x:Class="StoreManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StoreManager"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStyle="None"
        Style="{StaticResource MaterialDesignWindow}"
        Height="600" Width="1000"
        Title="StoreManager">

    <Grid>
        <!-- Login Grid -->
        <Grid x:Name="LoginGrid" Visibility="Visible">  <!-- while in development switch to Hidden/Visible -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Image Source="/Images/Cart.png" Stretch="Uniform" Width="200" Height="200"/>
            </Grid>
            <Grid Grid.Column="1">
                <Button Content="X" FontSize="20" Width="35" Height="35" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15" Click="CloseButton_Click"/>
                <StackPanel Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Welcome/ Login Text -->
                    <TextBlock Text="Store Manager Login" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <TextBox x:Name="UserNameTextBox" FontSize="15" Height="55" Margin="0,0,0,20" materialDesign:HintAssist.Hint="Username" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                    <!-- Password -->
                    <PasswordBox x:Name="PasswordBox" FontSize="15" Height="55" Margin="0,0,0,30" materialDesign:HintAssist.Hint="Password" Style="{StaticResource MaterialDesignFloatingHintRevealPasswordBox}"/>
                    <!-- Login -->
                    <Button x:Name="LoginButton" Content="LOGIN" Height="45" Click="LoginButton_Click"/>
                    <!-- Support     change link in CommandParameter -->
                    <Button Content="Contact Support" Margin="0,50,0,0" Background="Transparent" BorderThickness="0" Opacity="0.7" Command="{Binding LinkOpenCommand}" CommandParameter="https://google.com"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="HomeGrid" Visibility="Hidden">
            <!-- while in development switch to Hidden/Visible -->
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Buttons Panel -->
            <Grid Grid.Row="0" Background="Green">
                <DockPanel LastChildFill="True">

                    <!-- Time -->
                    <TextBlock x:Name="ClockText" DockPanel.Dock="Left" Text="00:00:00" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,25,0"/>
                    <!-- Panel's buttons -->
                    <Menu Background="Transparent" VerticalAlignment="Center">

                        <MenuItem Header="Home" Foreground="White" FontSize="16" FontWeight="Bold"/>

                        <MenuItem Header="Checkout" Foreground="White" FontSize="16" FontWeight="Bold"/>

                        <MenuItem Header="Dashboard" Foreground="White" FontSize="16" FontWeight="Bold"/>

                        <MenuItem Header="Inventory" Foreground="White" FontSize="16" FontWeight="Bold"/>

                        <MenuItem Header="Settings" Foreground="White" FontSize="16" FontWeight="Bold">
                            <MenuItem Header="Exit" Click="CloseButton_Click"/>
                        </MenuItem>
                    </Menu>
                </DockPanel>
                <TextBlock x:Name="DateText" DockPanel.Dock="Right" Text="00:00:00" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0"/>
            </Grid>

            <!-- Main Area -->
            <Grid Grid.Row="1" Background="White">
                <Grid x:Name="WelcomeGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical">
                        <TextBlock Text="Welcome to Store Manager," FontSize="24" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,120,0,0"/>
                        <TextBlock Text="User" x:Name="WelcomeUserNameText" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="Green" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <Button BorderBrush="{x:Null}" Background="{x:Null}" VerticalAlignment="Center" HorizontalAlignment="Center" Height="50" Margin="0,10,0,0" Click="ToCheckoutBtn_Click">
                            <Image Source="/Images/accept.png" Stretch="Uniform" Width="40" Height="40"/>
                        </Button>
                        <TextBlock Text="Click to proceed to the Cash Register." FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Grid>
            
            <!-- Checkout -->
            <Grid x:Name="CheckoutGrid" Visibility="Hidden">
                <!-- while in development switch to Hidden/Visible -->
                <TextBlock Text="Checkout" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
